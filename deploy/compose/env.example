#
# Vorlage für .env (cp env.example .env). Nur Platzhalter – echte Werte nie einchecken.
POSTGRES_PASSWORD=bitte-aendern
# Image (lokal gebaut oder aus der eigenen Registry)
AIGW_IMAGE=ai-gw:dev
# Fester Bootstrap-Token für die Erstinstallation (leer = einmalig erzeugt, siehe Logs)
AIGW_BOOTSTRAP_TOKEN=
# OTLP-Collector (nur mit --profile otel): http://otel-collector:4318
AIGW_OTLP_ENDPOINT=
AIGW_LOG=info
